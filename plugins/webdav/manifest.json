{
  "id": "webdav",
  "name": "WebDAV 存储",
  "version": "1.0.1",
  "type": "storage",
  "entry": "plugin/main.py",
  "permissions": ["net.outbound"],
  "sdk_version": "1.0",
  "config_schema": [
    {
      "key": "url",
      "label": "服务地址",
      "type": "text",
      "required": true,
      "placeholder": "https://dav.example.com/dav",
      "full": true
    },
    {
      "key": "username",
      "label": "用户名",
      "type": "text"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password"
    },
    {
      "key": "token",
      "label": "Bearer Token（可选）",
      "type": "password",
      "full": true
    },
    {
      "key": "readonly",
      "label": "只读模式（禁写）",
      "type": "checkbox"
    }
  ]
}
