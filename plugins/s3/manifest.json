{
  "id": "s3",
  "name": "S3 对象存储",
  "version": "1.0.1",
  "type": "storage",
  "entry": "plugin/main.py",
  "permissions": ["net.outbound"],
  "sdk_version": "1.0",
  "config_schema": [
    {
      "key": "bucket",
      "label": "存储桶 Bucket",
      "type": "text",
      "required": true,
      "placeholder": "如：hjcloud-data",
      "full": true
    },
    {
      "key": "endpoint",
      "label": "Endpoint 地址",
      "type": "text",
      "placeholder": "如：https://s3.amazonaws.com",
      "full": true
    },
    {
      "key": "access_key",
      "label": "Access Key",
      "type": "text"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password"
    },
    {
      "key": "region",
      "label": "区域 Region",
      "type": "text",
      "placeholder": "us-east-1"
    },
    {
      "key": "path_style",
      "label": "Path-Style 寻址（MinIO 勾选）",
      "type": "checkbox"
    },
    {
      "key": "readonly",
      "label": "只读模式（禁写）",
      "type": "checkbox"
    }
  ]
}
